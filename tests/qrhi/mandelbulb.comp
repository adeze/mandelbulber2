#version 440

// Mandelbulber classic formula: Copyright (C) 2020 Mandelbulber Team, GPLv3.
// See mandelbulber2/COPYING.

layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Points { vec4 points[]; };
layout(std430, binding = 1) writeonly buffer Results { vec4 results[]; };

// Port of formula/opencl/mandelbulb.cl, power 8, zero angular offsets.
// shortcut: fixed single formula and iteration policy; replace with scene parameters before integration.
vec3 distanceEstimate(vec3 point)
{
    vec3 z = point;
    float derivative = 1.0;
    float radius = length(z);
    for (int iteration = 0; iteration < 32; ++iteration) {
        if (radius > 8.0)
            return vec3(0.5 * radius * log(radius) / derivative, 1.0, float(iteration));
        // The spherical transform has an undefined angle at zero; its limiting output is zero.
        if (radius < 1e-20) {
            z = point;
            derivative = 1.0;
        } else {
            float theta = asin(clamp(z.z / radius, -1.0, 1.0)) * 8.0;
            float phi = atan(z.y, z.x) * 8.0;
            float radiusPower = pow(radius, 7.0);
            derivative = radiusPower * derivative * 8.0 + 1.0;
            radiusPower *= radius;
            z = radiusPower * vec3(cos(theta) * cos(phi), cos(theta) * sin(phi), sin(theta));
            z += point;
        }
        radius = length(z);
    }
    return vec3(0.0, 0.0, 32.0);
}

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index < 12u) {
        results[index] = vec4(distanceEstimate(points[index].xyz), 1.0);
        return;
    }
    uint pixel = index - 12u;
    if (pixel >= 64u * 64u)
        return;
    vec2 uv = (vec2(pixel % 64u, pixel / 64u) + 0.5) / 64.0 * 2.0 - 1.0;
    vec3 origin = vec3(0.0, -3.5, 0.0);
    vec3 direction = normalize(vec3(uv.x * 0.65, 1.0, uv.y * 0.65));
    float travel = 0.0;
    float hit = 0.0;
    for (int step = 0; step < 128; ++step) {
        float distance = distanceEstimate(origin + direction * travel).x;
        if (isnan(distance) || isinf(distance)) {
            results[index] = vec4(distance);
            return;
        }
        if (distance < 0.001) {
            hit = 1.0;
            break;
        }
        travel += distance * 0.7;
        if (travel > 7.0)
            break;
    }
    float shade = hit * clamp(1.0 - travel / 7.0, 0.0, 1.0);
    results[index] = vec4(shade, shade * 0.8, shade * 0.55, hit);
}
